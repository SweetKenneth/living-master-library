{
  "project": {
    "name": "[ENTER PROJECT NAME HERE]",
    "description": "[ENTER ONE-LINE PROJECT DESCRIPTION HERE]",
    "repository": ""
  },
  "roadmap": {
    "staleAfterDays": 45,
    "shipCandidateThreshold": 0.72,
    "implementationCandidateThreshold": 0.58,
    "duplicateThreshold": 0.82,
    "maxEvidencePerItem": 8,
    "maxUnplannedSignals": 40
  },
  "sourcePolicy": {
    "maxFiles": 2500,
    "maxFileBytes": 512000,
    "maxExcerptChars": 24000,
    "maxCommits": 200,
    "includeExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs", ".py", ".go", ".rs", ".java", ".kt", ".cs", ".rb", ".php", ".sql", ".md", ".mdx", ".txt", ".json", ".yaml", ".yml", ".toml", ".ini", ".html", ".css", ".scss", ".sh", ".ps1", ".xml"],
    "excludeDirectories": [".git", "node_modules", "dist", "build", "coverage", ".next", ".cache", ".turbo", ".venv", "venv", ".living", ".livingroadmap"],
    "excludeFiles": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock"],
    "sensitiveNamePatterns": ["^\\.env(?:\\..+)?$", "\\.(?:pem|key|p12|pfx)$", "(?:secret|credentials?|token)s?\\.(?:json|ya?ml|txt)$"]
  },
  "output": {
    "markdownFile": "ROADMAP.md",
    "htmlFile": "roadmap.html",
    "auditFile": "ROADMAP-AUDIT.md",
    "driftFile": "ROADMAP-DRIFT.md"
  },
  "seed": "livingroadmap"
}
